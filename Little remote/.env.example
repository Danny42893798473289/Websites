# Signaling server
PORT=5500
HOST=0.0.0.0

# WebSocket URL (used by host agent and viewer)
SIGNALING_URL=ws://localhost:5500
VITE_SIGNALING_URL=ws://localhost:5500
VIEWER_URL=http://localhost:5500

# Optional fixed PIN on host PC (4–8 digits)
HOST_PIN=

# TURN server (optional, required for many internet connections)
TURN_URL=turn:your-turn.example.com:3478
TURN_USER=your-turn-username
TURN_PASS=your-turn-password

# Viewer also reads VITE_ prefixed vars
VITE_TURN_URL=turn:your-turn.example.com:3478
VITE_TURN_USER=your-turn-username
VITE_TURN_PASS=your-turn-password
