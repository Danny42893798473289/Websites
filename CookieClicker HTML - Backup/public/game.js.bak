
let currentUser="",loaded=false;

let cookies=40;
let grandmas=0,farms=0,factories=0,oils=0,mines=0;
let coops=0,wormholes=0,galaxies=0,empties=0;

let pets=[],equipped=[],hatching=null,marketPlots=[],seeds=[],gardenPlots=[],waterCans=[],produce=[];
let vines = 0;
let selectedCanIndex = null;
let xp = 0, boosters = 0, whyEggs = 0;
let masteryPath = null;
let masteryUnlocked = [];

const COOKIE_TICK_MS = 2400000;
const START_COOKIES = 40;
const WHY_EGG_PER_COOKIES = 50000;
const PRESTIGE_MIN_COOKIES = 50000;

async function login(){
let r=await fetch("/login",{method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:user.value,password:pass.value})});
let d=await r.json();
if(d.success){currentUser=user.value;showGame();load();}
}

async function register(){
await fetch("/register",{method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:user.value,password:pass.value})});
alert("registered");
}

async function load(){
let r=await fetch("/load",{method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:currentUser})});
let d=await r.json();

if(d){
  // ✅ FIXED (only change)
  cookies = Number(d.cookies) || 40;
  grandmas = Number(d.grandmas) || 0;
  farms = Number(d.farms) || 0;
  factories = Number(d.factories) || 0;
  oils = Number(d.oils) || 0;
  mines = Number(d.mines) || 0;
  coops = Number(d.coops) || 0;
  wormholes = Number(d.wormholes) || 0;
  galaxies = Number(d.galaxies) || 0;
  empties = Number(d.empties) || 0;

  pets = Array.isArray(d.pets) ? d.pets : [];
  equipped = Array.isArray(d.equipped) ? d.equipped : [];
  hatching = (d.hatching && typeof d.hatching === "object") ? d.hatching : null;
  marketPlots = Array.isArray(d.marketPlots) ? d.marketPlots : [];
  ensureMarketPlots();
  seeds = Array.isArray(d.seeds) ? d.seeds : [];
  gardenPlots = Array.isArray(d.gardenPlots) ? d.gardenPlots : [];
  ensureGardenPlots();
  waterCans = Array.isArray(d.waterCans) ? d.waterCans : [];
  produce = Array.isArray(d.produce) ? d.produce : [];
  vines = Number(d.vines) || 0;
  xp = Number(d.xp) || 0;
  boosters = Number(d.boosters) || 0;
  whyEggs = Number(d.whyEggs) || 0;
  masteryPath = d.masteryPath || null;
  masteryUnlocked = Array.isArray(d.masteryUnlocked) ? d.masteryUnlocked : [];
}

loaded=true;
update();
}

function save(){
fetch("/save",{method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:currentUser,data:{
  cookies,grandmas,farms,factories,oils,mines,coops,wormholes,galaxies,empties,
  pets,equipped,hatching,marketPlots,seeds,gardenPlots,waterCans,produce,vines,
  xp,boosters,whyEggs,masteryPath,masteryUnlocked
}})});
}

const MASTERY_PATHS = {
  fortune: { name: 'Fortune', icon: '🍪' },
  prestige: { name: 'Ascension', icon: '✨' },
  pets: { name: 'Beast', icon: '🥚' }
};

const MASTERY_NODES = [
  { id: 'fortune_root', path: 'fortune', row: 0, col: 0, cost: 5, requires: [], label: 'Start with 200 cookies', desc: 'After prestige, begin with 200 cookies instead of 40.' },
  { id: 'fortune_income', path: 'fortune', row: 1, col: 0, cost: 10, requires: ['fortune_root'], label: '+25% building income', desc: 'Main-shop buildings produce 25% more cookies per tick.' },
  { id: 'fortune_passive', path: 'fortune', row: 2, col: -1, cost: 15, requires: ['fortune_income'], label: '+50% passive cookies', desc: '40-minute passive ticks grant 50% more.' },
  { id: 'fortune_start500', path: 'fortune', row: 2, col: 1, cost: 15, requires: ['fortune_income'], label: 'Start with 500 cookies', desc: 'After prestige, begin with 500 cookies (overrides 200).' },

  { id: 'prestige_root', path: 'prestige', row: 0, col: 0, cost: 5, requires: [], label: 'Double why egg gain', desc: 'Earn twice as many why eggs when you prestige.' },
  { id: 'prestige_booster', path: 'prestige', row: 1, col: 0, cost: 10, requires: ['prestige_root'], label: '+1 booster on prestige', desc: 'Gain an extra booster each time you prestige.' },
  { id: 'prestige_multi', path: 'prestige', row: 2, col: -1, cost: 15, requires: ['prestige_booster'], label: 'Why eggs +0.075 multi', desc: 'Each why egg gives +0.075 multiplier instead of +0.05.' },
  { id: 'prestige_cap', path: 'prestige', row: 2, col: 1, cost: 15, requires: ['prestige_booster'], label: '+50 why egg cap', desc: 'Increases your maximum why egg storage by 50.' },

  { id: 'pets_root', path: 'pets', row: 0, col: 0, cost: 5, requires: [], label: 'Double hatch speed', desc: 'Pets hatch twice as fast.' },
  { id: 'pets_slot', path: 'pets', row: 1, col: 0, cost: 10, requires: ['pets_root'], label: 'Third pet slot', desc: 'Equip up to 3 pets at once.' },
  { id: 'pets_discount', path: 'pets', row: 2, col: -1, cost: 15, requires: ['pets_slot'], label: 'Eggs 25% cheaper', desc: 'All pet eggs cost 25% fewer cookies.' },
  { id: 'pets_boost', path: 'pets', row: 2, col: 1, cost: 15, requires: ['pets_slot'], label: 'Hatch boosters 2× on pets', desc: 'Booster fast-forward affects hatch timers twice as much.' }
];

function hasMastery(id){ return masteryUnlocked.includes(id); }

function getMasteryNode(id){ return MASTERY_NODES.find(n => n.id === id); }

function getStartCookies(){
  if(hasMastery('fortune_start500')) return 500;
  if(hasMastery('fortune_root')) return 200;
  return START_COOKIES;
}

function getWhyEggMultiPerEgg(){
  return hasMastery('prestige_multi') ? 0.075 : 0.05;
}

function getWhyEggCap(){
  return 200 + 10 * xp + (hasMastery('prestige_cap') ? 50 : 0);
}

function getWhyEggsFromCookies(amount){
  let earned = Math.round((Number(amount) || 0) / WHY_EGG_PER_COOKIES);
  if(hasMastery('prestige_root')) earned *= 2;
  return earned;
}

function getHatchSpeedMult(){
  return hasMastery('pets_root') ? 2 : 1;
}

function getMaxEquipSlots(){
  return hasMastery('pets_slot') ? 3 : 2;
}

function getBuildingMult(){
  return hasMastery('fortune_income') ? 1.25 : 1;
}

function getPassiveMult(){
  return hasMastery('fortune_passive') ? 1.5 : 1;
}

function getPetEggCost(cost){
  return hasMastery('pets_discount') ? Math.ceil(cost * 0.75) : cost;
}

function getBoosterHatchMult(){
  return hasMastery('pets_boost') ? 2 : 1;
}

function canUnlockMastery(id){
  const node = getMasteryNode(id);
  if(!node || hasMastery(id)) return false;
  if(whyEggs < node.cost) return false;
  if(masteryPath && masteryPath !== node.path) return false;
  if(node.requires.length && !node.requires.every(r => hasMastery(r))) return false;
  if(!masteryPath && node.requires.length) return false;
  return true;
}

function unlockMastery(id){
  const node = getMasteryNode(id);
  if(!node || !canUnlockMastery(id)) return;
  if(!confirm(`Unlock "${node.label}" for ${node.cost} why egg(s)?`)) return;
  whyEggs -= node.cost;
  masteryUnlocked.push(id);
  if(!masteryPath) masteryPath = node.path;
  save();
  update();
}

function renderMastery(){
  const tree = document.getElementById('masteryTree');
  const info = document.getElementById('masteryInfo');
  if(!tree) return;

  if(info){
    if(!masteryPath){
      info.textContent = 'Choose a path by unlocking its top node. The other two paths will lock permanently.';
    } else {
      const p = MASTERY_PATHS[masteryPath];
      info.textContent = `Locked into ${p.icon} ${p.name} path. Unlock nodes adjacent to ones you already own.`;
    }
  }

  tree.innerHTML = '';
  const paths = ['fortune', 'prestige', 'pets'];
  const maxRow = Math.max(...MASTERY_NODES.map(n => n.row));

  paths.forEach(pathKey => {
    const col = document.createElement('div');
    col.className = 'mastery-path' + (masteryPath && masteryPath !== pathKey ? ' locked-path' : '');
    const pathMeta = MASTERY_PATHS[pathKey];
    const header = document.createElement('div');
    header.className = 'mastery-path-header';
    header.textContent = `${pathMeta.icon} ${pathMeta.name}`;
    col.appendChild(header);

    for(let row = 0; row <= maxRow; row++){
      const rowNodes = MASTERY_NODES.filter(n => n.path === pathKey && n.row === row);
      if(!rowNodes.length) continue;
      const rowEl = document.createElement('div');
      rowEl.className = 'mastery-row';
      rowNodes.sort((a,b) => a.col - b.col).forEach(node => {
        const btn = document.createElement('button');
        const unlocked = hasMastery(node.id);
        const available = canUnlockMastery(node.id);
        const lockedPath = masteryPath && masteryPath !== pathKey;
        btn.className = 'mastery-node';
        if(unlocked) btn.classList.add('unlocked');
        else if(lockedPath) btn.classList.add('path-locked');
        else if(available) btn.classList.add('available');
        else btn.classList.add('locked');
        btn.innerHTML = `<span class="mastery-label">${node.label}</span><span class="mastery-cost">${unlocked ? '✓' : node.cost + ' 🥚'}</span>`;
        btn.title = node.desc;
        if(available) btn.onclick = () => unlockMastery(node.id);
        else if(!unlocked) btn.disabled = true;
        rowEl.appendChild(btn);
      });
      col.appendChild(rowEl);
    }
    tree.appendChild(col);
  });
}

function resetPrestigeProgress(){
  cookies = getStartCookies();
  grandmas = 0; farms = 0; factories = 0; oils = 0; mines = 0;
  coops = 0; wormholes = 0; galaxies = 0; empties = 0;
  pets = []; equipped = []; hatching = null;
}

function canPrestige(){
  return cookies >= PRESTIGE_MIN_COOKIES;
}

function prestige(){
  if(!canPrestige()){
    alert(`You need at least ${PRESTIGE_MIN_COOKIES.toLocaleString()} cookies to prestige.`);
    return;
  }

  const earned = getWhyEggsFromCookies(cookies);
  const cap = getWhyEggCap();
  const space = Math.max(0, cap - whyEggs);
  const added = Math.min(earned, space);

  if(!confirm(
    `Prestige now?\n\nResets: cookies, main shop, pets.\nKeeps: garden, seeds, produce, vines, cans.\n\n+1 XP, +1 booster\n+${added} why egg(s) (${whyEggs} → ${whyEggs + added}, cap ${cap})`
  )) return;

  whyEggs += added;
  xp += 1;
  boosters += 1 + (hasMastery('prestige_booster') ? 1 : 0);
  resetPrestigeProgress();
  save();
  update();
}

function fastForwardMinutes(minutes){
  const ticks = minutes / 40;
  const gain = Math.floor(getBase() * getMulti() * getPassiveMult() * ticks);
  cookies += gain;
  if(hatching){
    const hatchSkip = minutes * 60 * getBoosterHatchMult();
    hatching.time = Math.max(0, hatching.time - hatchSkip);
    if(hatching.time <= 0){
      pets.push(hatching.multi);
      hatching = null;
    }
  }
  return gain;
}

function useBooster(count){
  const cost = count === 2 ? 2 : 1;
  const minutes = count === 2 ? 120 : 40;
  if(boosters < cost){
    const el = document.getElementById('boosterResult');
    if(el) el.textContent = `Need ${cost} booster(s), you have ${boosters}.`;
    return;
  }
  boosters -= cost;
  const gained = fastForwardMinutes(minutes);
  save();
  update();
  const el = document.getElementById('boosterResult');
  if(el) el.textContent = `Fast-forwarded ${minutes} min — gained ${gained.toLocaleString()} cookies.`;
}

function updatePrestigeUI(){
  const cap = getWhyEggCap();
  const preview = getWhyEggsFromCookies(cookies);
  const ready = canPrestige();
  const set = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };
  set('prestigeXp', xp);
  set('prestigeBoosters', boosters);
  set('prestigeWhyEggs', whyEggs);
  set('prestigeWhyCap', cap);
  set('prestigeWhyPreview', preview);
  set('xpHud', xp);
  set('boostersHud', boosters);
  set('whyEggsHud', `${whyEggs} / ${cap} (+${getWhyEggMulti().toFixed(2)} multi)`);

  const btn = document.getElementById('prestigeBtn');
  if(btn){
    btn.disabled = !ready;
    btn.title = ready ? '' : `Requires ${PRESTIGE_MIN_COOKIES.toLocaleString()} cookies`;
  }
  const status = document.getElementById('prestigeStatus');
  if(status){
    status.textContent = ready
      ? 'Ready to prestige.'
      : `Need ${Math.max(0, PRESTIGE_MIN_COOKIES - Math.floor(cookies)).toLocaleString()} more cookies (minimum ${PRESTIGE_MIN_COOKIES.toLocaleString()}).`;
  }
}

function getBase(){
const raw = grandmas+farms*12+factories*31+oils*125+mines*200+
coops*310+wormholes*780+galaxies*20000+empties*250000;
return Math.floor(raw * getBuildingMult());
}

function getWhyEggMulti(){ return whyEggs * getWhyEggMultiPerEgg(); }

function getMulti(){
  let m = 1;
  equipped.forEach(p => m += p);
  m += getWhyEggMulti();
  return m;
}

// ✅ FIXED
function buy(val,cost){
  val = Number(val) || 0;
  if(cookies >= cost){
    cookies -= cost;
    return val + 1;
  }
  return val;
}

function buyGrandma(){grandmas=buy(grandmas,1);update();save();}
function buyFarm(){farms=buy(farms,10);update();save();}
function buyFactory(){factories=buy(factories,25);update();save();}
function buyOil(){oils=buy(oils,100);update();save();}
function buyMine(){mines=buy(mines,150);update();save();}
function buyCoop(){coops=buy(coops,200);update();save();}
function buyWormhole(){wormholes=buy(wormholes,500);update();save();}
function buyGalaxy(){galaxies=buy(galaxies,10000);update();save();}
function buyEmpty(){empties=buy(empties,100000);update();save();}

function buyPetTiny(){
  const cost = getPetEggCost(50);
  if(cookies>=cost && !hatching){
    cookies -= cost;
    hatching = {multi:0.05, time:40*60};
    save();
    update();
  }
}

function buyPetSmall(){
  const cost = getPetEggCost(100);
  if(cookies>=cost && !hatching){
    cookies -= cost;
    hatching = {multi:0.2, time:160*60};
    save();
    update();
  }
}

function buyPetBig(){
  const cost = getPetEggCost(500);
  if(cookies>=cost && !hatching){
    cookies -= cost;
    hatching = {multi:1, time:1440*60};
    save();
    update();
  }
}

function buyPetLarge(){
  const cost = getPetEggCost(1000);
  if(cookies>=cost && !hatching){
    cookies -= cost;
    hatching = {multi:4, time:4*24*60*60};
    save();
    update();
  }
}

function buyPetEnormas(){
  const cost = getPetEggCost(2000);
  if(cookies>=cost && !hatching){
    cookies -= cost;
    hatching = {multi:10, time:7*24*60*60};
    save();
    update();
  }
}

function cancelHatch(){
  if(hatching){
    hatching = null;
    save();
    update();
  }
}

function ensureMarketPlots(){
  if(!Array.isArray(marketPlots)) marketPlots = [];
  while(marketPlots.length < 9) marketPlots.push({ state: 'empty' });
  for(let i=0;i<marketPlots.length;i++){
    if(!marketPlots[i] || !marketPlots[i].state) marketPlots[i] = { state: 'empty' };
  }
}

function ensureGardenPlots(){
  if(!Array.isArray(gardenPlots)) gardenPlots = [];
  while(gardenPlots.length < 100) gardenPlots.push({ state: 'locked' });
  // unlock center 4x4
  for(let r=3;r<=6;r++){
    for(let c=3;c<=6;c++){
      const idx = r*10 + c;
      if(!gardenPlots[idx] || gardenPlots[idx].state === 'locked') gardenPlots[idx] = { state: 'empty' };
    }
  }
  // ensure other cells exist
  for(let i=0;i<100;i++){
    if(!gardenPlots[i]) gardenPlots[i] = { state: 'locked' };
  }
}

function buyBasicCan(){
  if(cookies < 1000) return;
  cookies -= 1000;
  waterCans.push({ type: 'basic', lastUsedAt: 0 });
  save();
  update();
}

